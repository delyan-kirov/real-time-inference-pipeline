{
  // --- CMake ----------------------------------------------------------------
  // The CMake Tools extension reads CMakePresets.json directly, so there is no
  // duplicated build configuration in here. Status bar at the bottom lets you
  // switch preset, build (F7) and run.
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,

  // Applies to the status-bar Run (Shift+F5) and Debug buttons, for whichever
  // target is selected. Arguments deliberately are NOT set here: cmake.debugConfig
  // is global across targets, so args meant for `rfd` would also be handed to
  // `rfd-smoke`. Per-target arguments live in launch.json instead.
  "cmake.debugConfig": {
    "cwd": "${workspaceFolder}",
    "environment": [
      // Only gst-inspect/gst-launch need this - `rfd` registers rfdface
      // in-process - but it is set so plugin loading can be debugged too.
      { "name": "GST_PLUGIN_PATH", "value": "${workspaceFolder}/build/dev/source" },
      // 2 is quiet. Raise to 4 for element lifecycle, or use rfdface:6 to see
      // one line per frame from our own element.
      { "name": "GST_DEBUG", "value": "2" },
      { "name": "ASAN_OPTIONS", "value": "detect_leaks=1" }
    ],
    "MIMode": "gdb",
    "setupCommands": [
      { "description": "Pretty-print STL containers", "text": "-enable-pretty-printing", "ignoreFailures": true }
    ]
  },

  // --- IntelliSense ---------------------------------------------------------
  // clangd, not the Microsoft C/C++ engine. Under Nix the system headers live in
  // /nix/store paths that cpptools guesses badly; clangd just reads the exact
  // flags out of compile_commands.json and is always right.
  "C_Cpp.intelliSenseEngine": "disabled",
  // No --compile-commands-dir: CMakeLists.txt symlinks compile_commands.json
  // to the source root, which clangd finds by itself. That keeps this working
  // whichever preset you configured, and for reviewers using their own build
  // directory instead of our presets.
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--header-insertion=never",
    "--completion-style=detailed"
  ],

  // --- Formatting -----------------------------------------------------------
  "editor.formatOnSave": true,
  "[cpp]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "[c]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },

  "files.associations": { "*.hpp": "cpp", "*.h": "cpp" },
  "files.exclude": {
    "**/build": true,
    "**/.cache": true,
    "**/.direnv": true
  },
  "nixEnvSelector.nixFile": "${workspaceFolder}/flake.nix",
  "nixEnvSelector.useFlakes": true,
  "nixEnvSelector.flakeShell": "default"
}
